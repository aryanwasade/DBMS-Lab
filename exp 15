Q.design a trigger such that no insertion or updation is done on sat or sun(for practice. You create trigger for wed)
create or replace trigger trg_day
before insert or update on emp2
begin
if to_char(sysdate,'day')='WEDNESDAY' then
RAISE_APPLICATION_ERROR(-20004,'no insertion or updation is allowed on Wednesday');
end if;
end;
/
----------------------------------------------------------------------------------------------------------------
using variable
--------------------
CREATE OR REPLACE TRIGGER tr_day
BEFORE INSERT OR UPDATE ON emp2
FOR EACH ROW
DECLARE
    v_day VARCHAR2(10);
BEGIN
    v_day := TO_CHAR(SYSDATE, 'DY');
    IF v_day = 'WED' THEN
        RAISE_APPLICATION_ERROR(-20001, 'Insertion or updation is prohibited on ' || v_day);
    END IF;
END;
/
